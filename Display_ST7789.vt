`timescale 1ns/1ps

module tb_mux21;
    // Fast simulation clock & small 4x4 panel so full frame completes quickly
    localparam integer SIM_CLK_HZ        = 1_000_000; // 1 MHz -> 1000 ns period
    localparam [15:0]  SIM_WIDTH         = 16'd4;
    localparam [15:0]  SIM_HEIGHT        = 16'd4;
    localparam [15:0]  SIM_HALF_PERIOD   = 16'd2;
    localparam [15:0]  SIM_FILL_COLOR    = 16'hF800;

    reg  clk = 1'b0;
    wire clk_en;

    wire lcd_sck;
    wire lcd_sck_oe;
    wire lcd_mosi;
    wire lcd_mosi_oe;
    wire lcd_cs_n;
    wire lcd_cs_n_oe;
    wire lcd_dc;
    wire lcd_dc_oe;
    wire lcd_reset_n;
    wire lcd_reset_n_oe;
    wire lcd_backlight;
    wire lcd_backlight_oe;

    // 1 MHz clock (500 ns half-period)
    always #500 clk = ~clk;

    mux21 #(
        .CLK_HZ(SIM_CLK_HZ),
        .LCD_WIDTH(SIM_WIDTH),
        .LCD_HEIGHT(SIM_HEIGHT),
        .SPI_HALF_PERIOD(SIM_HALF_PERIOD),
        .MADCTL_VAL(8'h00),
        .COLMOD_VAL(8'h55),
        .FILL_COLOR(SIM_FILL_COLOR),
        .BACKLIGHT_ON(1'b1),
        .BACKLIGHT_OFF(1'b0)
    ) dut (
        .clk(clk),
        .clk_en(clk_en),
        .lcd_sck(lcd_sck),
        .lcd_sck_oe(lcd_sck_oe),
        .lcd_mosi(lcd_mosi),
        .lcd_mosi_oe(lcd_mosi_oe),
        .lcd_cs_n(lcd_cs_n),
        .lcd_cs_n_oe(lcd_cs_n_oe),
        .lcd_dc(lcd_dc),
        .lcd_dc_oe(lcd_dc_oe),
        .lcd_reset_n(lcd_reset_n),
        .lcd_reset_n_oe(lcd_reset_n_oe),
        .lcd_backlight(lcd_backlight),
        .lcd_backlight_oe(lcd_backlight_oe)
    );

    // Track RESX low pulse timing and verify DCX on first command byte (0x01)
    time rst_fall_time;
    time rst_rise_time;
    reg  saw_rst_low = 1'b0;
    reg  saw_rst_high_after_low = 1'b0;
    reg  checked_first_cmd = 1'b0;

    always @(negedge lcd_reset_n) begin
        rst_fall_time = $time;
        saw_rst_low = 1'b1;
    end

    always @(posedge lcd_reset_n) begin
        if (saw_rst_low) begin
            rst_rise_time = $time;
            saw_rst_high_after_low = 1'b1;
            $display("[%0t ns] RESX asserted low for %0t ns, then released high.",
                     $time, rst_rise_time - rst_fall_time);
        end
    end

    // SPI Mode 0 slave monitor: sample MOSI on rising edge of SCK while CSX is low
    reg [7:0] rx_byte = 8'h00;
    integer   bit_cnt = 0;
    integer   byte_count = 0;

    always @(posedge lcd_sck or posedge lcd_cs_n) begin
        if (lcd_cs_n) begin
            bit_cnt <= 0;
        end else begin
            rx_byte = {rx_byte[6:0], lcd_mosi};
            bit_cnt = bit_cnt + 1;
            if (bit_cnt == 8) begin
                byte_count = byte_count + 1;
                if (!checked_first_cmd) begin
                    checked_first_cmd = 1'b1;
                    $display("[%0t ns] First SPI byte = 0x%02h with DCX = %b",
                             $time, rx_byte, lcd_dc);
                    if (lcd_dc !== 1'b0) begin
                        $display("ERROR: Expected DCX=0 during first command byte!");
                    end
                end
                bit_cnt <= 0;
            end
        end
    end

    initial begin
        $dumpfile("tb_mux21.vcd");
        $dumpvars(0, tb_mux21);

        // Wait until lcd_backlight turns on or timeout occurs
        #80_000_000; // 80 ms max sim window at 1 MHz (adjust if needed)

        if (!saw_rst_low || !saw_rst_high_after_low) begin
            $display("WARNING: RESX low-to-high pulse not observed within simulation window.");
        end

        $display("Simulation finished at %0t ns: total SPI bytes = %0d, CSX = %b, DCX = %b, BL = %b",
                 $time, byte_count, lcd_cs_n, lcd_dc, lcd_backlight);
        $finish;
    end
endmodule
